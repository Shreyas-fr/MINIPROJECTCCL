# ==============================================================================
# SurgeGate - Cloud Infrastructure Configuration
# Copy this file to 'config.env' and customize values before running deploy.sh
# DO NOT commit 'config.env' containing sensitive passwords to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS Account & General Project Settings
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
PROJECT_NAME=surgegate
ENVIRONMENT=dev

# ------------------------------------------------------------------------------
# 2. Networking (VPC & Subnets)
# ------------------------------------------------------------------------------
VPC_CIDR=10.0.0.0/16
# Two public subnets across different Availability Zones (required for ALB)
PUBLIC_SUBNET_1_CIDR=10.0.1.0/24
PUBLIC_SUBNET_2_CIDR=10.0.2.0/24
# Two private subnets across different Availability Zones (for RDS DB Subnet Group)
PRIVATE_SUBNET_1_CIDR=10.0.11.0/24
PRIVATE_SUBNET_2_CIDR=10.0.12.0/24

# Student Budget Safety:
# Set to 'true' ONLY if private instances require outbound internet via NAT Gateway.
# A NAT Gateway costs ~$32/month per gateway + data transfer charges.
# Default is 'false' (EC2 instances run in public subnets with public IPs and secured SGs).
ENABLE_NAT_GATEWAY=false

# ------------------------------------------------------------------------------
# 3. Application & EC2 Compute Configuration
# ------------------------------------------------------------------------------
APP_PORT=3000
EC2_INSTANCE_TYPE=t3.micro
# Allowed CIDR to access the ALB HTTP endpoint (0.0.0.0/0 for public testing, or your specific IP)
ALLOWED_HTTP_CIDR=0.0.0.0/0

# Auto Scaling Group Parameters
ASG_MIN_SIZE=1
ASG_DESIRED_CAPACITY=1
ASG_MAX_SIZE=2
ASG_TARGET_CPU_UTILIZATION=70.0

# ------------------------------------------------------------------------------
# 4. Amazon RDS Database Configuration (MySQL)
# ------------------------------------------------------------------------------
ENABLE_RDS=true
DB_NAME=surgegate
DB_USERNAME=surgegate_admin
# Database master password:
# Leave blank to be prompted securely at deployment time without echoing to screen.
# If set here, ensure permissions on config.env are restricted (chmod 600 config.env).
DB_PASSWORD=""
DB_INSTANCE_CLASS=db.t3.micro
DB_ALLOCATED_STORAGE=20
DB_MAX_ALLOCATED_STORAGE=50
DB_STORAGE_TYPE=gp3

# ------------------------------------------------------------------------------
# 5. Asynchronous Messaging & Serverless Ticket Processing
# ------------------------------------------------------------------------------
ENABLE_SQS=true
SQS_QUEUE_NAME=surgegate-ticket-queue
SQS_DLQ_NAME=surgegate-ticket-dlq
# Message visibility timeout (must be >= Lambda function timeout)
SQS_VISIBILITY_TIMEOUT=60
SQS_MAX_RECEIVE_COUNT=3

ENABLE_LAMBDA=true
LAMBDA_FUNCTION_NAME=surgegate-ticket-processor
LAMBDA_RUNTIME=python3.11
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY_SIZE=128

ENABLE_SNS=false
SNS_TOPIC_NAME=surgegate-booking-notifications
NOTIFICATION_EMAIL=""

# ------------------------------------------------------------------------------
# 6. S3 Storage Configuration
# ------------------------------------------------------------------------------
# Global S3 bucket name will be generated with a random suffix if not specified here:
# e.g., surgegate-tickets-dev-<account_id>-<random>
S3_BUCKET_NAME=""

# ------------------------------------------------------------------------------
# 7. CloudWatch Monitoring & Cost Controls
# ------------------------------------------------------------------------------
ENABLE_CLOUDWATCH_ALARMS=true
ENABLE_ALB=true
ENABLE_AUTOSCALING=true
