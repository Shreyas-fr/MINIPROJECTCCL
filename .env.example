# ==============================================================================
# SurgeGate - Local Development & Cloud Integration Environment Template
# Copy this file to '.env' for local docker-compose or native Python execution
# ==============================================================================

PROJECT_NAME=SurgeGate
ENVIRONMENT=dev
APP_PORT=8000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=surgegate
DB_USER=surgegate_admin
DB_PASSWORD=surgegate_secret
DATABASE_URL=mysql+pymysql://surgegate_admin:surgegate_secret@localhost:3306/surgegate?charset=utf8mb4

# Authentication
JWT_SECRET_KEY=surgegate-super-secret-jwt-key-2026-ccl-mini-project
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Virtual Waiting Room Parameters
QUEUE_ADMISSION_BATCH_SIZE=5
QUEUE_ADMISSION_INTERVAL_SECONDS=5
QUEUE_TOKEN_TTL_MINUTES=15
QUEUE_HEARTBEAT_TIMEOUT_SECONDS=45

# Seat Reservation Lock Duration (Seconds)
SEAT_HOLD_DURATION_SECONDS=300

# AWS Service Integration (Local Mock Enabled by Default)
USE_AWS_MOCK=true
AWS_REGION=ap-south-1
SURGEGATE_SQS_URL=
SURGEGATE_S3_BUCKET=
LOCAL_STORAGE_DIR=./storage
